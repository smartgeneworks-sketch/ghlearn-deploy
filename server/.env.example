# GH Learn API environment. Copy to server/.env for local use. NEVER commit real values.
# Secrets live only here / in the host's environment; System settings (stored in MongoDB) never hold secrets.
# Settings marked [ceiling] or [seed] are refined in Admin › System settings / AI usage and costs.

# ---- Core ----
NODE_ENV=development
PORT=8080
# Empty in dev = in-memory MongoDB (not persisted). REQUIRED in production.
MONGODB_URI=
# Database name when MONGODB_URI has none (live: ghlearn)
MONGODB_DB=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  (>= 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# [seed] defaults for System settings › Sessions (access token minutes, stay-signed-in days)
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
# Comma-separated frontend origins (CORS + CSRF Origin check)
CORS_ORIGINS=http://localhost:5173
# Cross-site (web.app → onrender.com): COOKIE_SECURE=true and COOKIE_SAMESITE=none
# Same-site custom domain (ghlearn.com → api.ghlearn.com): COOKIE_SAMESITE=lax; optional COOKIE_DOMAIN=.ghlearn.com
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Production CORS (comma-separated). Keep the .web.app origin while migrating.
# CORS_ORIGINS=https://ghlearn.com,https://www.ghlearn.com,https://ghlearn-f31c9.web.app
# [ceiling] false switches self-registration off whatever System settings › Feature flags says
SELF_REGISTRATION=true
LOG_LEVEL=info
# Dev only: seed SAMPLE data into the in-memory DB at start
SEED_ON_START=false
# Password for the SAMPLE accounts created by bootstrap/seed (secret on the live deploy)
SEED_PASSWORD=

# ---- Files and ingestion ----
STORAGE_PROVIDER=gridfs
# [ceiling] largest upload; System settings › Uploads can only go lower
UPLOAD_MAX_MB=60
GRIDFS_QUOTA_MB=150
REMOTE_FETCH_HOSTS=curriculumresources.edu.gh,drive.usercontent.google.com
WORKER_ENABLED=true
WORKER_POLL_MS=3000
# tesseract = OCR for scanned pages (needs ~300 MB RAM); empty = off
OCR_PROVIDER=
OCR_LANG=eng
# [ceiling] OCR pages per manual
OCR_MAX_PAGES=40

# ---- AI providers. Empty = feature disabled (never faked). Keys are shown in the admin only as set/unset. ----
GEMINI_API_KEY=
# gemini (default when a key is set). The model is chosen in Admin › AI usage and costs; LLM_MODEL is the fallback.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Changing the embedding model needs a full re-index, so it stays in the environment.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BASE_URL=
IMAGE_PROVIDER=
IMAGE_API_KEY=
# local (in-process cosine) or atlas (Atlas Vector Search)
VECTOR_SEARCH=local
QUESTION_CROSSCHECK=true
ATTEMPT_GRACE_SEC=10
# [seed] first values of the AI limits (then edited in Admin › AI usage and costs)
LLM_DAILY_REQUEST_BUDGET=40
# Monthly hard caps (first-run defaults for AI settings). Cost is estimated from AI_COST_*_PER_M; 0 = no cost cap.
LLM_MONTHLY_REQUEST_BUDGET=10000
LLM_MONTHLY_COST_BUDGET_USD=10
LLM_DAILY_TOKEN_BUDGET=2000000
AI_USER_DAILY_REQUESTS=30
AI_SCHOOL_DAILY_REQUESTS=200
AI_COST_INPUT_PER_M=0.3
AI_COST_OUTPUT_PER_M=2.5
TUTOR_DAILY_MESSAGES_PER_USER=60
# [seed] System settings › Data retention › Tutor conversations
TUTOR_RETENTION_DAYS=180

# ---- Email (optional; empty = in-app notifications only) ----
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=

# ---- Production bootstrap ----
# Indexes + vector index + sample seed + subject seed + catalog import, in the background after listen
BOOTSTRAP_ON_START=false
BOOTSTRAP_DATA_DIR=data
